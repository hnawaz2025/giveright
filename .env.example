# Copy to .env and fill in. .env is gitignored; never commit it.

# A Bedrock API key (IAM -> API keys for Amazon Bedrock -> long-term key).
# botocore reads this name natively, so nothing in this project handles the
# key itself. Works instead of ~/.aws/credentials, and from any account.
AWS_BEARER_TOKEN_BEDROCK=

# Region. The us. inference profiles the models use are US-only.
AWS_REGION=us-east-1

# Optional: swap either model role without touching code.
# GIVERIGHT_VISION_MODEL=us.amazon.nova-premier-v1:0
# GIVERIGHT_AGENT_MODEL=us.amazon.nova-pro-v1:0
